{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "jsx": "react-native",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "lib": ["esnext", "dom"],
    "skipLibCheck": true,
    "types": ["react", "react-native", "react-test-renderer"]
  },
  "include": ["src/**/*", "react.d.ts"],
  "exclude": ["node_modules"]
}
